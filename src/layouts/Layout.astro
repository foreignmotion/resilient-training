---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Button from '../components/Button.astro';
import { site } from '../../shared/config.ts';
import bgPhoto from '../assets/images/image06_litter-rigging-overlook.jpg';
import shareDefault from '../assets/images/image06_litter-rigging-overlook.jpg';

interface Props {
  title: string;
  description: string;
  /** Which nav item is current. */
  current?: 'home' | 'ncrt' | 'register';
  /** Absolute or root-relative share image; defaults to the site background photo. */
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  footerLinks?: { href: string; label: string }[];
  noindex?: boolean;
}
const { title, description, current, ogImage, jsonLd, noindex, footerLinks = [
  { href: '/ncrt/', label: 'Team' },
  { href: '/policies/', label: 'Policies' },
  { href: '/register/', label: 'Register' },
] } = Astro.props;

const [bgLarge, bgSmall, share] = await Promise.all([
  getImage({ src: bgPhoto, width: 1920, format: 'webp', quality: 60 }),
  getImage({ src: bgPhoto, width: 900, format: 'webp', quality: 55 }),
  getImage({ src: shareDefault, width: 1200, height: 630, fit: 'cover', format: 'jpg' }),
]);
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogImage ?? share.src, site.url).href;
const home = current === 'home';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#13150f" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.orgName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700&family=Dela+Gothic+One&display=swap" />
  <link rel="preload" as="image" href={bgSmall.src} media="(max-width: 900px)" fetchpriority="high" />
  <link rel="preload" as="image" href={bgLarge.src} media="(min-width: 901px)" fetchpriority="high" />
  <style set:html={`:root{--photo:url("${bgLarge.src}")}@media (max-width:900px){:root{--photo:url("${bgSmall.src}")}}`} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <div class="backdrop" aria-hidden="true"></div>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="/" class="brand" aria-current={home ? 'page' : undefined}><img src="/favicon.svg" alt="" class="brand-mark" width="32" height="32" />{site.orgName}</a>
      <nav class="nav" aria-label="Main">
        <a href="/#course">Courses</a>
        <a href="/ncrt/" aria-current={current === 'ncrt' ? 'page' : undefined}>Team</a>
        <a href="/#contact">Contact</a>
        {current === 'register'
          ? <a href="/register/" aria-current="page">Register</a>
          : <Button variant="solid" href="/register/">Register</Button>}
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="topbar footer">
    <div class="wrap footer-inner">
      <p class="eyebrow">© {year} {site.orgName} · {site.region}</p>
      <nav class="nav" aria-label="Footer">
        {footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </footer>
</body>
</html>
<style>
  main:focus { outline: none; }
</style>
