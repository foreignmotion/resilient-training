---
import Layout from '../../layouts/Layout.astro';
import Panel from '../../components/Panel.astro';
import Button from '../../components/Button.astro';
import { course, mailtoHref, site } from '../../../shared/config.ts';
---
<Layout
  title={`You’re registered | ${site.orgName}`}
  description={`Registration confirmation for ${course.name}.`}
  current="register"
  noindex
  footerLinks={[{ href: '/', label: 'Home' }, { href: '/ncrt/', label: 'Team' }]}
>
  <section class="wrap stack reveal" style="padding-top: 5rem; padding-bottom: 3rem; gap: 1.5rem;">
    <p class="eyebrow">Register · Complete</p>
    <h1 class="t-heading">{course.name}</h1>
  </section>
  <div class="wrap" style="padding-bottom: 6rem;">
    <Panel>
      <div class="stack" style="gap: 2rem; max-width: 46rem;" data-confirm role="status">
        <header class="section-header">
          <p class="eyebrow">Registration complete</p>
          <h2 class="title title-section">See you Wednesday</h2>
        </header>
        <p class="t-body" data-confirm-line>Thank you. Your payment went through, and a confirmation email is on its way. We’ll email the training location before class.</p>
        <p class="t-body">Questions before then? Email <a href={mailtoHref()}>{site.email}</a>.</p>
        <div class="btns"><Button variant="solid" href="/">Back to home</Button></div>
      </div>
    </Panel>
  </div>
</Layout>

<script>
  import { course } from '../../../shared/config.ts';
  import { formatClassDate } from '../../../shared/dates.ts';

  // Fill in the date and email from the server once the Stripe redirect lands here.
  const id = new URLSearchParams(location.search).get('r');
  const line = document.querySelector<HTMLElement>('[data-confirm-line]');
  try { sessionStorage.removeItem('registration-draft-v1'); } catch {}
  if (id && line) {
    fetch(`/api/registrations/${encodeURIComponent(id)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d: any) => {
        if (!d?.classDate) return;
        const lead = d.status === 'paid' ? 'You’re registered for' : 'We’re confirming your payment for';
        line.textContent = `${lead} ${formatClassDate(d.classDate)}, ${course.timeLabel}. We’ll email the training location to ${d.email} before class.`;
      })
      .catch(() => {});
  }
</script>
